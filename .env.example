# Copier ce fichier en .env et l'adapter.

# Fournisseur d'IA : "demo" fonctionne sans clé (heuristiques, pour la démonstration).
# Un fournisseur de modèle de langage hébergé sera ajouté avant le 21 novembre.
SCENORA_AI_PROVIDER=demo

# Clé d'API du fournisseur hébergé (laisser vide en mode demo). Ne jamais la versionner.
SCENORA_AI_API_KEY=

# Chemin de la base SQLite locale.
SCENORA_DB=scenora.db
